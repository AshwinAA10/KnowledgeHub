# =============================================================================
# KnowledgeHub Backend — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.
# =============================================================================

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true

# ── Database ─────────────────────────────────────────────────────────────────
# These must match the values in docker-compose.yml (or your own Postgres)
#
# NOTE: Port 5433 is used because Windows PostgreSQL 18 occupies localhost:5432.
# The Docker container's internal port remains 5432; only the host-side mapping
# is changed (see docker-compose.yml: "5433:5432").
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=knowledgehub
POSTGRES_PASSWORD=knowledgehub_dev_password
POSTGRES_DB=knowledgehub

# Derived DATABASE_URL — update if you changed any of the above
DATABASE_URL=postgresql://knowledgehub:knowledgehub_dev_password@localhost:5433/knowledgehub
